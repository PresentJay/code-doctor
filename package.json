{
  "name": "@presentjay/code-doctor",
  "version": "0.1.0-rc.2",
  "description": "Read agent code changes in context, then give precise feedback in the same workflow.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "code-doctor": "bin/code-doctor.mjs"
  },
  "files": [
    "bin",
    "src",
    "web",
    "skills",
    "docs",
    "ops",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs examples/native-probe/check.test.mjs",
    "check": "npm test && node scripts/check-package.mjs",
    "doctor": "node bin/code-doctor.mjs doctor",
    "mcp": "node bin/code-doctor.mjs mcp",
    "demo": "node examples/native-probe/server.mjs",
    "build:ui": "esbuild web/ui.tsx --bundle --format=esm --minify --external:/app.mjs --outfile=web/ui.js && tailwindcss -i web/shadcn-input.css -o web/shadcn.css --minify"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/cli": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PresentJay/code-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/PresentJay/code-doctor/issues"
  },
  "homepage": "https://github.com/PresentJay/code-doctor#readme",
  "publishConfig": {
    "access": "public"
  }
}
